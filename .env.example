APP_NAME=Date Agent MVP
APP_ENV=dev
DB_PATH=data/date_agent.db

# GLM configuration (Zhipu)
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
GLM_CHAT_MODEL=glm-4-flash
GLM_CHAT_FALLBACK_MODEL=glm-4-plus
GLM_EMBEDDING_MODEL=

# Optional web search (latest news/facts)
TAVILY_API_KEY=
WEB_SEARCH_TIMEOUT_SEC=10
WEB_SEARCH_MAX_RESULTS=5

# Local runtime context (auto attached to each model call)
LOCAL_ADDRESS=
DEFAULT_WEATHER_LOCATION=
LOCAL_TIMEZONE=Asia/Shanghai
LOCAL_CONTEXT_HINT=

# Timeline display config
TIMELINE_START_HOUR=8

# Optional local file-based fixed schedule config
FIXED_SCHEDULE_FILE=data/fixed_schedules.json
